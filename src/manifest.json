{
  "manifest_version": 3,
  "name": "Prettiefy GraphQL Payload",
  "version": "0.1.0",
  "description": "Paste a GraphQL JSON payload (e.g. from BC) and prettify it locally as you type.",
  "action": {
    "default_title": "Prettiefy GraphQL Payload",
    "default_popup": "popup.html"
  },

  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "34": "icons/icon-34.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["clipboardWrite"]
}

